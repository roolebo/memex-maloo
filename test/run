#!/usr/bin/env bash
#
# test/run: tests of memex-maloo, offline.
#
# curl is test/bin/curl, a fake that answers from fixtures in
# test/fixtures and logs what the adapter asked. Each test gets its own
# routes, log and HOME, so its own script name cache, under a temporary
# directory; MALOO_USER and MALOO_PASSWORD are unset unless the test sets
# them.
#

set -e

CURDIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
ADAPTER=$(dirname "$CURDIR")/memex-maloo
ADDR=https://testing.example.org
API=$ADDR/api
# A password curl's config must quote
SECRET='pa"ss\word'
DIR=$(mktemp -d)
FAILED=0

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 [TEST...]

Runs the given tests, or all of them:
$(declare -F | cut -d' ' -f3 | grep '^test_' | sed 's/^/  /')
EOF
}

cleanup() {
  rm -rf "$DIR"
}

# Answer METHOD URL with test/fixtures/FIXTURE, or nothing for -, and
# HTTP status CODE, 200 by default
route() {
  echo "$1 $2 $3 ${4:-200}" >> "$FAKE/routes"
}

# Run the adapter's ci role: ARGS, stdin from IN; sets OUT, ERR and
# STATUS
call() {
  STATUS=0
  "$ADAPTER" "$ADDR" ci "$@" < "$IN" > "$TEST_DIR/out" \
    2> "$TEST_DIR/err" || STATUS=$?
  OUT=$(< "$TEST_DIR/out")
  ERR=$(< "$TEST_DIR/err")
}

# jq FILTER on the records printed, as one array
records() {
  jq -scr "$1" <<< "$OUT"
}

# jq FILTER on the requests curl got, as one array
requests() {
  touch "$FAKE/log"
  jq -scr "$1" "$FAKE/log"
}

login() {
  export MALOO_USER=jdoe@example.org MALOO_PASSWORD=$SECRET
}

check() {
  [ "$2" == "$3" ] && return
  echo "# $1: expected '$3', got '$2'"
  FAILED=$((FAILED + 1))
}

check_has() {
  [[ $2 == *"$3"* ]] && return
  echo "# $1: '$2' lacks '$3'"
  FAILED=$((FAILED + 1))
}

# Compare jq FILTER on the records with the JSON on stdin
check_json() {
  check "$1" "$(jq -sc "$2" <<< "$OUT" | jq -cS .)" "$(jq -cS .)"
}

# Fails a test that asked for something without a route or put the
# password on curl's command line
audit() {
  local bad
  [ -f "$FAKE/log" ] || return 0
  bad=$(jq -r --arg secret "$SECRET" '
      if .unexpected then "unexpected request: \(.method) \(.url)"
      elif (.args + [.url] | any(contains($secret)))
      then "password on the command line: \(.url)"
      else empty end' "$FAKE/log")
  [ -n "$bad" ] || return 0
  sed 's/^/# /' <<< "$bad"
  FAILED=$((FAILED + 1))
}

test_capabilities() {
  call capabilities
  check status "$STATUS" 0
  check_json capabilities '.[0]' << 'EOF'
{"tests": true, "logs": false, "retest": true, "bugs": true}
EOF
  check requests "$(requests length)" 0
}

test_other_role() {
  STATUS=0
  "$ADAPTER" "$ADDR" tracker capabilities < "$IN" 2> /dev/null || STATUS=$?
  check status "$STATUS" 2
}

test_unknown_command() {
  call locate cdc3609
  check status "$STATUS" 2
}

test_logs() {
  call logs 3b4c5d6e-7f80-4912-a3b4-c5d6e7f80910
  check status "$STATUS" 2
  check requests "$(requests length)" 0
}

test_usage() {
  call run
  check "no run" "$STATUS" 1
  call run '5e2c0d6a&id=x'
  check "not an id" "$STATUS" 1
  call runs cdc360g
  check "not a commit" "$STATUS" 1
  STATUS=0
  "$ADAPTER" testing.example.org ci run 1 < "$IN" 2> /dev/null ||
    STATUS=$?
  check "not a URL" "$STATUS" 1
  check requests "$(requests length)" 0
}

SHA=cdc360986f2590957d6fb1296b7bccfa5fdafa34
S50=5e2c0d6a-1f3b-4c2e-9a7d-0b1c2d3e4f50
S51=5e2c0d6a-1f3b-4c2e-9a7d-0b1c2d3e4f51
S52=5e2c0d6a-1f3b-4c2e-9a7d-0b1c2d3e4f52
MASTER=77d1e2f3-a4b5-4c6d-8e7f-9a0b1c2d3e4f

# The code reviews of SHA come in pages of 2; the third page is short
route_runs() {
  route GET "$API/code_reviews?commit_id=$SHA&offset=0" reviews-0.json
  route GET "$API/code_reviews?commit_id=$SHA&offset=2" reviews-2.json
  route GET "$API/code_reviews?commit_id=$SHA&offset=4" reviews-4.json
  route GET "$API/test_sessions?id=$S50" session-50.json
  route GET "$API/test_sessions?id=$S51" session-51.json
  route GET "$API/test_sessions?id=$S52" session-52.json
}

# Each session appears once; reviews of other commits are dropped
test_runs() {
  route_runs
  call runs "$SHA"
  check status "$STATUS" 0
  check runs "$(records '[.[].id] | join(" ")')" "$S50 $S51 $S52"
  check_json run '.[0]' << EOF
{"id": "$S50", "source": "$ADDR", "role": "ci", "kind": "run",
 "basis": "5:3:1:1:3600",
 "links": [["commit", "$SHA"], ["change", "69978"], ["revision", "2"]],
 "data": {"commit": "$SHA", "status": "done", "result": "fail",
          "started": "2026-10-23T14:20:00Z",
          "finished": "2026-10-23T15:20:00Z",
          "url": "$ADDR/test_sessions/$S50",
          "config": {
            "test_group": "review-ldiskfs",
            "test_name":
              "lustre-reviews-el9.7-x86_64--review-ldiskfs--1.134377",
            "test_host": "onyx-41vm1", "trigger_job": "lustre-reviews"}},
 "notes": {}}
EOF
  check_json others '.[1:] | map([.links, .data.result, .data.config])' \
    << EOF
[[[["commit", "$SHA"], ["change", "69978"], ["revision", "2"]], "error",
  {"test_group": "review-zfs",
   "test_name": "lustre-reviews-el9.7-x86_64--review-zfs--1.134377",
   "test_host": "onyx-42vm1", "trigger_job": "lustre-reviews"}],
 [[["commit", "$SHA"], ["change", "69978"], ["revision", "2"]], "pass",
  {"test_group": "review-dne-part-1",
   "test_name": "lustre-reviews-el9.7-x86_64--review-dne-part-1--1.134377",
   "test_host": "onyx-43vm1"}]]
EOF
  check anonymous "$(requests '[.[].auth] | unique | tojson')" '[null]'
}

test_runs_uppercase() {
  route_runs
  call runs CDC360986F2590957D6FB1296B7BCCFA5FDAFA34
  check status "$STATUS" 0
  check count "$(records length)" 3
}

test_runs_none() {
  route GET "$API/code_reviews?commit_id=0123abc&offset=0" empty.json
  call runs 0123abc
  check status "$STATUS" 0
  check output "$OUT" ''
}

test_runs_fail() {
  route GET "$API/code_reviews?commit_id=$SHA&offset=0" reviews-0.json
  route GET "$API/code_reviews?commit_id=$SHA&offset=2" - 502
  call runs "$SHA"
  check status "$STATUS" 1
  check_has error "$ERR" "Cannot read $API/code_reviews?commit_id=$SHA"
  check output "$OUT" ''
}

# The password goes to curl in its config on stdin
test_runs_logged_in() {
  login
  route_runs
  call runs "$SHA"
  check status "$STATUS" 0
  check auth "$(requests '[.[].auth] | unique | .[]')" stdin
  check user "$(requests '[.[].user] | unique | .[]')" \
    "jdoe@example.org:$SECRET"
}

test_runs_netrc() {
  echo 'machine testing.example.org login jdoe password x' > "$HOME/.netrc"
  route_runs
  call runs "$SHA"
  check status "$STATUS" 0
  check auth "$(requests '[.[].auth] | unique | .[]')" netrc
}

test_run() {
  route GET "$API/code_reviews?test_session_id=$S50" review-session.json
  route GET "$API/test_sessions?id=$S50" session-50.json
  call run "$S50"
  check status "$STATUS" 0
  check_json run '.[0] | [.id, .links, .data.result]' << EOF
["$S50", [["commit", "$SHA"], ["change", "69978"], ["revision", "2"]],
 "fail"]
EOF
}

# A branch build tested no review
test_run_no_review() {
  route GET "$API/code_reviews?test_session_id=$MASTER" empty.json
  route GET "$API/test_sessions?id=$MASTER" session-master.json
  call run "$MASTER"
  check status "$STATUS" 0
  check_json run '.[0] | [.basis, .links, .data]' << EOF
["60:60:0:0:null", [],
 {"commit": null, "status": "done", "result": "pass",
  "started": "2026-10-20T03:00:00Z", "finished": "2026-10-20T03:00:00Z",
  "url": "$ADDR/test_sessions/$MASTER",
  "config": {"test_group": "full",
             "test_name": "lustre-master-el9.7-x86_64--full--1.4567",
             "test_host": "trevis-12vm1", "trigger_job": "lustre-master"}}]
EOF
}

test_run_missing() {
  route GET "$API/code_reviews?test_session_id=$S50" empty.json
  route GET "$API/test_sessions?id=$S50" empty.json
  call run "$S50"
  check status "$STATUS" 1
  check_has error "$ERR" "No test session $S50"
}

run() {
  local failed=$FAILED
  TEST=$1
  TEST_DIR=$DIR/$1
  IN=$TEST_DIR/in
  mkdir -p "$TEST_DIR/home"
  : > "$IN"
  (
    export HOME=$TEST_DIR/home
    export FAKE=$TEST_DIR
    "$1"
    audit
    exit $((FAILED - failed))
  ) || FAILED=$((FAILED + $?))
  if [ $FAILED -eq $failed ]; then
    echo "ok $1"
  else
    echo "not ok $1"
  fi
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
command -v jq > /dev/null || die "jq is not installed"
trap cleanup EXIT
export PATH=$CURDIR/bin:$PATH
[ "$(command -v curl)" == "$CURDIR/bin/curl" ] || die "curl is not the fake"
export FIXTURES=$CURDIR/fixtures
unset MALOO_USER MALOO_PASSWORD XDG_CACHE_HOME

TESTS=("$@")
[ $# -gt 0 ] || TESTS=($(declare -F | cut -d' ' -f3 | grep '^test_'))
for test in "${TESTS[@]}"; do
  declare -F "$test" > /dev/null || die "No such test: $test"
  run "$test"
done
[ $FAILED -eq 0 ] || die "$FAILED failed"
